# ─── GEMINI API KEYS (Ключи нейросети) ───
# Один ключ Gemini:
GEMINI_API_KEY="AIzaSy..."

# ПУЛ КЛЮЧЕЙ ДЛЯ ОТКАЗОУСТОЙЧИВОСТИ:
# Можно указать несколько ключей от разных Google Cloud проектов через запятую.
# Если на одном ключе исчерпается минутная квота (429 Too Many Requests), сервер мгновенно переключится на следующий!
GEMINI_API_KEYS="AIzaSyKey1...,AIzaSyKey2...,AIzaSyKey3..."

# Также можно задать отдельными переменными:
# GEMINI_API_KEY_1="AIzaSyKey1..."
# GEMINI_API_KEY_2="AIzaSyKey2..."

# Модель нейросети (по умолчанию gemini-3.8-flash):
GEMINI_MODEL="gemini-3.8-flash"

# ─── TELEGRAM БОТ ДЛЯ МИНИ-АППА И ТРАНСЛЯЦИЙ ───
# Токен бота от @BotFather (например: 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ):
TG_BOT_TOKEN=""

# ID канала или чата для трансляций матчей (например, @my_virt_rpl или -1001234567890):
TG_CHAT_ID=""

# ─── URL СЕРВЕРА И БАЗА ДАННЫХ ───
# URL сайта/хостинга (автоматически или ваш домен Railway / Render / VPS):
APP_URL="MY_APP_URL"

# Секретный код администратора (по умолчанию 1234):
ADMIN_CODE="1234"
